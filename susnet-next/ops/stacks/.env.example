# Copy to .env before first startup.
TZ=America/New_York

# Portainer
PORTAINER_HTTPS_PORT=9444

# Node-RED
NODERED_PORT=1881
NODERED_ADMIN_USER=<set-admin-user>
NODERED_ADMIN_PASS_HASH=
NODERED_CREDENTIAL_SECRET=<set-long-random-secret>

# MQTT
MQTT_PORT=1883

# ChirpStack
CHIRPSTACK_API_PORT=8081
CHIRPSTACK_GWBRIDGE_UDP_PORT=1701
CHIRPSTACK_DB_USER=chirpstack
CHIRPSTACK_DB_PASSWORD=<set-strong-db-password>
CHIRPSTACK_DB_NAME=chirpstack
