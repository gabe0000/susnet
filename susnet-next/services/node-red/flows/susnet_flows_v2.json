  {"id":"ui_theme","type":"ui_template","z":"f_runtime","group":"ui_grp_home_status","name":"Theme","order":1,"width":"24","height":"1","format":"<style>\nbody.nr-dashboard-theme md-content{background:linear-gradient(135deg,#081124 0%,#0d1c35 100%)!important;color:#d9e8ff!important;}\n.nr-dashboard-theme .nr-dashboard-cardtitle{color:#8fb8ff!important;font-weight:700;letter-spacing:.2px;}\n.nr-dashboard-theme md-card{border:1px solid rgba(93,164,255,.35);box-shadow:0 0 12px rgba(57,136,255,.20);border-radius:12px;}\n.nr-dashboard-theme .nr-dashboard-button .md-button{border-radius:10px;font-weight:700;}\n</style>","storeOutMessages":false,"fwdInMessages":false,"resendOnRefresh":true,"templateScope":"global","className":"","x":180,"y":40,"wires":[[]]},

  {"id":"inj_health","type":"inject","z":"f_runtime","name":"Poll health (15s)","props":[{"p":"payload"}],"repeat":"15","once":true,"onceDelay":"2","topic":"","payload":"","payloadType":"date","x":130,"y":100,"wires":[["http_health"]]},
  {"id":"http_health","type":"http request","z":"f_runtime","name":"GET /api/health","method":"GET","ret":"obj","paytoqs":"ignore","url":"http://host.docker.internal:8088/api/health","tls":"","persist":false,"proxy":"","authType":"","x":340,"y":100,"wires":[["fn_health"]]},
  {"id":"fn_health","type":"function","z":"f_runtime","name":"Render health","func":"const ok = msg.payload && msg.payload.ok ? 'OK' : 'DOWN';\nconst ts = msg.payload && msg.payload.ts ? new Date(msg.payload.ts*1000).toLocaleString() : 'n/a';\nmsg.payload = `<b>SusNet API:</b> ${ok}<br/><b>Timestamp:</b> ${ts}<br/><b>Version:</b> ${(msg.payload&&msg.payload.version)||'n/a'}`;\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":550,"y":100,"wires":[["ui_health"]]},
  {"id":"ui_health","type":"ui_text","z":"f_runtime","group":"ui_grp_home_status","order":2,"width":"24","height":"2","name":"Health","label":"API Health","format":"{{msg.payload}}","layout":"row-spread","className":"","x":760,"y":100,"wires":[]},

  {"id":"inj_services","type":"inject","z":"f_runtime","name":"Poll services (15s)","props":[{"p":"payload"}],"repeat":"15","once":true,"onceDelay":"3","topic":"","payload":"","payloadType":"date","x":140,"y":160,"wires":[["http_services"]]},
  {"id":"http_services","type":"http request","z":"f_runtime","name":"GET /api/services","method":"GET","ret":"obj","paytoqs":"ignore","url":"http://host.docker.internal:8088/api/services","tls":"","persist":false,"proxy":"","authType":"","x":350,"y":160,"wires":[["fn_services"]]},
  {"id":"fn_services","type":"function","z":"f_runtime","name":"Render services","func":"const s = (msg.payload && msg.payload.services) || {};\nconst keys = Object.keys(s).sort();\nconst lines = keys.map(k => `${k}: ${s[k]}`);\nmsg.payload = lines.length ? lines.join('\\n') : 'No service data';\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":560,"y":160,"wires":[["ui_services","dbg_services"]]},
  {"id":"ui_services","type":"ui_text","z":"f_runtime","group":"ui_grp_home_services","order":1,"width":"24","height":"8","name":"Services","label":"Service States","format":"<pre style='white-space:pre-wrap'>{{msg.payload}}</pre>","layout":"col-center","className":"","x":770,"y":140,"wires":[]},
  {"id":"dbg_services","type":"debug","z":"f_runtime","name":"services(debug)","active":true,"tosidebar":true,"console":false,"tostatus":false,"complete":"payload","targetType":"msg","x":760,"y":180,"wires":[]},

  {"id":"inj_nodes","type":"inject","z":"f_runtime","name":"Poll nodes (20s)","props":[{"p":"payload"}],"repeat":"20","once":true,"onceDelay":"4","topic":"","payload":"","payloadType":"date","x":130,"y":240,"wires":[["http_nodes"]]},
  {"id":"http_nodes","type":"http request","z":"f_runtime","name":"GET /api/nodes","method":"GET","ret":"obj","paytoqs":"ignore","url":"http://host.docker.internal:8088/api/nodes","tls":"","persist":false,"proxy":"","authType":"","x":320,"y":240,"wires":[["fn_nodes"]]},
  {"id":"fn_nodes","type":"function","z":"f_runtime","name":"Render nodes (safe)","func":"const nodes = (msg.payload && msg.payload.nodes) || [];\nconst clean = nodes.map(n => ({id:n.id,host:n.host,user:n.user}));\nconst lines = clean.map(n => `${n.id} @ ${n.host} (user ${n.user||'n/a'})`);\nmsg.payload = lines.length ? lines.join('\\n') : 'No nodes found';\nmsg.cleanNodes = clean;\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":530,"y":240,"wires":[["ui_nodes","ui_allstar_links"]]},
  {"id":"ui_nodes","type":"ui_text","z":"f_runtime","group":"ui_grp_allstar_nodes","order":1,"width":"24","height":"8","name":"AllStar Nodes","label":"Configured Nodes","format":"<pre style='white-space:pre-wrap'>{{msg.payload}}</pre>","layout":"col-center","className":"","x":770,"y":220,"wires":[]},
