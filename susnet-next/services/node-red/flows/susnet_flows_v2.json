  {"id":"http_extnodes","type":"http request","z":"f_runtime","name":"GET /api/allstar/gmrs-extnodes?node=531121&limit=20","method":"GET","ret":"obj","paytoqs":"ignore","url":"http://host.docker.internal:8088/api/allstar/gmrs-extnodes?node=531121&limit=20","tls":"","persist":false,"proxy":"","authType":"","x":490,"y":320,"wires":[["fn_extnodes"]]},
  {"id":"fn_extnodes","type":"function","z":"f_runtime","name":"Render GMRS list","func":"const entries = (msg.payload && msg.payload.entries) || [];\nmsg.payload = entries.length ? entries.map(e=>`${e.node}: ${e.data}`).join('\\n') : 'No GMRS extnode entries';\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":720,"y":320,"wires":[["ui_extnodes"]]},
