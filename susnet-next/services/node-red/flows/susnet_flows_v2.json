    "type": "function",
    "z": "f_runtime",
    "name": "Render mesh messages",
    "func": "const items = (msg.payload && msg.payload.items) || [];\nconst linesFallback = (msg.payload && msg.payload.lines) || [];\nif (items.length) {\n  msg.payload = items.slice(0,50).map(m => {\n    const sender = m.sender_displayName || m.sender_display_name || m.sender_name || m.sender || 'unknown';\n    const ch = m.kind === 'dm' ? 'DM' : (m.channel_name || m.channel || 'channel');\n    return `${m.time||''} [${ch}] ${sender}: ${m.text||''}`;\n  }).join('\\n');\n} else {\n  msg.payload = linesFallback.slice(0,50).join('\\n') || 'No mesh messages yet';\n}\nreturn msg;",
    "outputs": 1,
