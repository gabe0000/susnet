  {"id":"fn_mesh_tel","type":"function","z":"f_runtime","name":"Render mesh telemetry","func":"const lines = (msg.payload && msg.payload.lines) || [];\nmsg.payload = lines.slice(0,50).join('\\n') || 'No telemetry yet';\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":630,"y":660,"wires":[["ui_mesh_tel"]]},
  {"id":"ui_mesh_tel","type":"ui_text","z":"f_runtime","group":"ui_grp_mesh_tel","order":1,"width":"24","height":"10","name":"Mesh Telemetry","label":"Recent Mesh Telemetry","format":"<pre style='white-space:pre-wrap'>{{msg.payload}}</pre>","layout":"col-center","className":"","x":850,"y":660,"wires":[]},

