  },
  {
    "id": "http_health",
    "type": "http request",
    "z": "f_runtime",
    "name": "GET /api/health",
    "method": "GET",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "http://susnet-core-api:8080/api/health",
    "tls": "",
    "persist": false,
    "proxy": "",
    "authType": "",
    "x": 340,
    "y": 100,
    "wires": [
      [
        "fn_health"
      ]
    ]
  },
  {
    "id": "fn_health",
    "type": "function",
    "z": "f_runtime",
    "name": "Render health",
    "func": "const ok = msg.payload && msg.payload.ok ? 'OK' : 'DOWN';\nconst ts = msg.payload && msg.payload.ts ? new Date(msg.payload.ts*1000).toLocaleString() : 'n/a';\nmsg.payload = `<b>SusNet API:</b> ${ok}<br/><b>Timestamp:</b> ${ts}<br/><b>Version:</b> ${(msg.payload&&msg.payload.version)||'n/a'}`;\nreturn msg;",
    "outputs": 1,
    "timeout": "",
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 550,
    "y": 100,
    "wires": [
      [
        "ui_health"
      ]
    ]
  },
