  {"id":"http_tickets","type":"http request","z":"f_runtime","name":"GET /api/tickets","method":"GET","ret":"obj","paytoqs":"ignore","url":"http://host.docker.internal:8088/api/tickets","tls":"","persist":false,"proxy":"","authType":"","x":350,"y":740,"wires":[["fn_tickets"]]},
  {"id":"fn_tickets","type":"function","z":"f_runtime","name":"Render tickets","func":"const tickets = (msg.payload && msg.payload.tickets) || [];\nif (!tickets.length) { msg.payload='No tickets'; return msg; }\nmsg.payload = tickets.map(t => `${t.id} [${t.status||'open'}] ${t.title}`).join('\\n');\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":560,"y":740,"wires":[["ui_tickets"]]},
