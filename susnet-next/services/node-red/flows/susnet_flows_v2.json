  {"id":"inj_aprs_cfg","type":"inject","z":"f_runtime","name":"Poll APRS config (60s)","props":[{"p":"payload"}],"repeat":"60","once":true,"onceDelay":"4","topic":"","payload":"","payloadType":"date","x":150,"y":460,"wires":[["http_aprs_cfg"]]},
  {"id":"http_aprs_cfg","type":"http request","z":"f_runtime","name":"GET /api/aprs/config","method":"GET","ret":"obj","paytoqs":"ignore","url":"http://host.docker.internal:8088/api/aprs/config","tls":"","persist":false,"proxy":"","authType":"","x":360,"y":460,"wires":[["fn_aprs_cfg"]]},
  {"id":"fn_aprs_cfg","type":"function","z":"f_runtime","name":"Render APRS config","func":"const c = (msg.payload && msg.payload.config) || {};\nconst lines = [\n`callsign: ${c.callsign||'n/a'}`,\n`watch: ${c.watch||'n/a'}`,\n`zip: ${c.zip||'n/a'}`,\n`radius_miles: ${c.radius_miles||'n/a'}`,\n`target: ${c.target||'n/a'}`,\n`tts_mode: ${c.tts_mode||'n/a'}`,\n`tts_node: ${c.tts_node||'n/a'}`,\n`filter: ${c.filter||'n/a'}`\n];\nmsg.payload = lines.join('\\n');\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":580,"y":460,"wires":[["ui_aprs_cfg"]]},
  {"id":"ui_aprs_cfg","type":"ui_text","z":"f_runtime","group":"ui_grp_aprs_cfg","order":1,"width":"24","height":"5","name":"APRS Config","label":"Current APRS Config","format":"<pre style='white-space:pre-wrap'>{{msg.payload}}</pre>","layout":"col-center","className":"","x":790,"y":460,"wires":[]},

  {"id":"inj_aprs_msg","type":"inject","z":"f_runtime","name":"Poll APRS messages (20s)","props":[{"p":"payload"}],"repeat":"20","once":true,"onceDelay":"5","topic":"","payload":"","payloadType":"date","x":160,"y":520,"wires":[["http_aprs_msg"]]},
  {"id":"http_aprs_msg","type":"http request","z":"f_runtime","name":"GET /api/aprs/messages","method":"GET","ret":"obj","paytoqs":"ignore","url":"http://host.docker.internal:8088/api/aprs/messages","tls":"","persist":false,"proxy":"","authType":"","x":380,"y":520,"wires":[["fn_aprs_msg"]]},
  {"id":"fn_aprs_msg","type":"function","z":"f_runtime","name":"Render APRS messages","func":"const entries = (msg.payload && msg.payload.entries) || [];\nif (!entries.length) { msg.payload = 'No APRS messages yet'; return msg; }\nconst lines = entries.slice(0,50).map(e => `${e.ts||''} ${e.raw||e.text||JSON.stringify(e)}`);\nmsg.payload = lines.join('\\n');\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":610,"y":520,"wires":[["ui_aprs_msg"]]},
  {"id":"ui_aprs_msg","type":"ui_text","z":"f_runtime","group":"ui_grp_aprs_msgs","order":1,"width":"24","height":"10","name":"APRS Messages","label":"Recent APRS Messages","format":"<pre style='white-space:pre-wrap'>{{msg.payload}}</pre>","layout":"col-center","className":"","x":830,"y":520,"wires":[]},

  {"id":"inj_mesh_msg","type":"inject","z":"f_runtime","name":"Poll Mesh messages (15s)","props":[{"p":"payload"}],"repeat":"15","once":true,"onceDelay":"6","topic":"","payload":"","payloadType":"date","x":160,"y":600,"wires":[["http_mesh_msg"]]},
  {"id":"http_mesh_msg","type":"http request","z":"f_runtime","name":"GET /api/meshtastic/messages","method":"GET","ret":"obj","paytoqs":"ignore","url":"http://host.docker.internal:8088/api/meshtastic/messages","tls":"","persist":false,"proxy":"","authType":"","x":390,"y":600,"wires":[["fn_mesh_msg"]]},
  {"id":"fn_mesh_msg","type":"function","z":"f_runtime","name":"Render mesh messages","func":"const items = (msg.payload && msg.payload.items) || [];\nconst linesFallback = (msg.payload && msg.payload.lines) || [];\nif (items.length) {\n  msg.payload = items.slice(0,50).map(m => `${m.time||''} [${m.channel_name||m.channel||'channel'}] ${m.sender_name||m.sender||'unknown'}: ${m.text||''}`).join('\\n');\n} else {\n  msg.payload = linesFallback.slice(0,50).join('\\n') || 'No mesh messages yet';\n}\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":620,"y":600,"wires":[["ui_mesh_msg"]]},
  {"id":"ui_mesh_msg","type":"ui_text","z":"f_runtime","group":"ui_grp_mesh_msgs","order":1,"width":"24","height":"10","name":"Mesh Messages","label":"Recent Mesh Messages","format":"<pre style='white-space:pre-wrap'>{{msg.payload}}</pre>","layout":"col-center","className":"","x":840,"y":600,"wires":[]},

